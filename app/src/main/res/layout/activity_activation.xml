<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nx_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/activation_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Logo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MiChat Push Auto"
            android:textColor="@color/nx_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_activation_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Masukkan key lisensi untuk membuka aplikasi"
            android:textColor="@color/nx_text_2"
            android:textSize="14sp" />

        <!-- Banner status (kadaluarsa / dicabut / perlu online) -->
        <TextView
            android:id="@+id/tv_activation_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_info"
            android:backgroundTint="#33FFB547"
            android:padding="12dp"
            android:textColor="@color/nx_warn"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            style="@style/Nx.Card"
            android:layout_marginTop="18dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_key"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Key lisensi"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/nx_primary"
                app:endIconMode="clear_text"
                app:helperText="Contoh: MCA-ABCD-EFGH-JKLM"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="24"
                    android:singleLine="true"
                    android:textColor="@color/nx_text"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste_key"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:letterSpacing="0"
                android:text="📋 Tempel"
                android:textAllCaps="false"
                android:textColor="@color/nx_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="🔓  Aktifkan"
                android:textAllCaps="false"
                android:textColor="@color/nx_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/nx_primary"
                app:cornerRadius="16dp" />

            <ProgressBar
                android:id="@+id/pb_activation"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/nx_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_activation_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/nx_danger"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Device ID: dikirim ke penjual bila perlu reset/bantuan -->
        <LinearLayout
            android:id="@+id/row_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device ID"
                    android:textColor="@color/nx_text_3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_device_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/nx_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salin"
                android:textColor="@color/nx_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="1 key hanya untuk 1 HP. Belum punya key? Hubungi penjual."
            android:textColor="@color/nx_text_3"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Made by Nixxy"
            android:textColor="@color/nx_text_2"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
