<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nx_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- ============ HERO ============ -->
            <LinearLayout
                android:id="@+id/card_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_logo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stat_tile"
                        android:gravity="center"
                        android:text="⚡"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MiChat Push Auto"
                            android:textColor="@color/nx_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto sapa Pengguna di Sekitar"
                            android:textColor="@color/nx_text_2"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_status_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="● Siap"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tile_history"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_stat_history"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/nx_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sudah disapa"
                            android:textColor="@color/nx_text_2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_stat_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♀"
                            android:textColor="@color/nx_pink"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_stat_target_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target"
                            android:textColor="@color/nx_text_2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_tile"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_stat_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/nx_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Limit sesi"
                            android:textColor="@color/nx_text_2"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ IZIN ============ -->
            <LinearLayout
                android:id="@+id/card_permissions"
                style="@style/Nx.Card">

                <TextView
                    style="@style/Nx.SectionTitle"
                    android:text="🔐  Persiapan" />

                <TextView
                    android:id="@+id/tv_perm_sub"
                    style="@style/Nx.SectionSub"
                    android:text="Aktifkan 2 izin ini sekali saja" />

                <LinearLayout
                    android:id="@+id/row_perm_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_perm_overlay_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:text="!"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tampil di atas aplikasi lain"
                            android:textColor="@color/nx_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_perm_overlay_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Untuk tombol kontrol melayang"
                            android:textColor="@color/nx_text_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/nx_text_3"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_perm_access"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_perm_access_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:text="!"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Layanan Aksesibilitas"
                            android:textColor="@color/nx_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_perm_access_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Untuk membaca &amp; menekan layar MiChat"
                            android:textColor="@color/nx_text_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/nx_text_3"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ TARGET GENDER ============ -->
            <LinearLayout style="@style/Nx.Card">

                <TextView
                    style="@style/Nx.SectionTitle"
                    android:text="🎯  Target Gender" />

                <TextView
                    style="@style/Nx.SectionSub"
                    android:text="Siapa yang akan disapa bot" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gender_female"
                        style="@style/Nx.Toggle"
                        android:text="♀  Cewek" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gender_male"
                        style="@style/Nx.Toggle"
                        android:text="♂  Cowok" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gender_all"
                        style="@style/Nx.Toggle"
                        android:text="⚥  Semua" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_analyze_icon"
                    style="@style/Nx.Switch"
                    android:layout_marginTop="10dp"
                    android:text="Cek ikon gender di profil" />

                <TextView
                    style="@style/Nx.SwitchDesc"
                    android:text="Paling akurat. Membaca warna ikon ♀ pink / ♂ biru sebelum menekan Sapa Dia (Android 11+)." />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_analyze_name"
                    style="@style/Nx.Switch"
                    android:text="Tebak dari nama &amp; bio" />

                <TextView
                    style="@style/Nx.SwitchDesc"
                    android:text="Cadangan jika ikon tidak terbaca." />
            </LinearLayout>

            <!-- ============ FILTER ============ -->
            <LinearLayout style="@style/Nx.Card">

                <TextView
                    style="@style/Nx.SectionTitle"
                    android:text="🧹  Filter" />

                <TextView
                    style="@style/Nx.SectionSub"
                    android:text="Lewati kontak yang tidak perlu disapa" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_skip_friends"
                    style="@style/Nx.Switch"
                    android:text="Lewati yang sudah berteman" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_only_sapa"
                    style="@style/Nx.Switch"
                    android:text="Hanya yang ada tombol Sapa Dia" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_info"
                    android:padding="12dp"
                    android:text="🛡️  Nama yang sudah ada di Riwayat selalu dilewati, jadi tidak ada yang disapa dua kali."
                    android:textColor="@color/nx_text_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============ PESAN ============ -->
            <LinearLayout
                android:id="@+id/card_message"
                style="@style/Nx.Card">

                <TextView
                    style="@style/Nx.SectionTitle"
                    android:text="💬  Pesan Sapaan" />

                <TextView
                    style="@style/Nx.SectionSub"
                    android:text="Pakai sapaan bawaan atau tulis sendiri" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_default_greeting"
                    style="@style/Nx.Switch"
                    android:text="Pakai sapaan bawaan MiChat" />

                <LinearLayout
                    android:id="@+id/layout_custom_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_message"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Template pesan"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/nx_primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="200"
                        app:helperText="Variasi acak: {Halo|Hai} → Halo atau Hai"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_message_template"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:textColor="@color/nx_text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_message_preview"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Contoh pesan"
                            android:textColor="@color/nx_text_2"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_shuffle"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎲 Acak"
                            android:textAllCaps="false"
                            android:textColor="@color/nx_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ KECEPATAN ============ -->
            <LinearLayout style="@style/Nx.Card">

                <TextView
                    style="@style/Nx.SectionTitle"
                    android:text="⏱️  Kecepatan &amp; Limit" />

                <TextView
                    style="@style/Nx.SectionSub"
                    android:text="Jeda acak antar sapaan supaya aman" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jeda antar sapaan"
                        android:textColor="@color/nx_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_delay_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 – 6 dtk"
                        android:textColor="@color/nx_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/slider_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="30"
                    app:labelBehavior="gone"
                    app:minSeparation="0dp"
                    app:thumbColor="@color/nx_primary"
                    app:trackColorActive="@color/nx_primary"
                    app:trackColorInactive="#2C3344"
                    app:tickVisible="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Maksimal sapaan per sesi"
                        android:textColor="@color/nx_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_target_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 kontak"
                        android:textColor="@color/nx_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="20"
                    android:valueFrom="1"
                    android:valueTo="200"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/nx_primary"
                    app:trackColorActive="@color/nx_primary"
                    app:trackColorInactive="#2C3344"
                    app:tickVisible="false" />
            </LinearLayout>

            <!-- ============ RIWAYAT ============ -->
            <LinearLayout
                android:id="@+id/layout_btn_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stat_tile"
                    android:gravity="center"
                    android:text="📜"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Riwayat Sapaan"
                        android:textColor="@color/nx_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_main_history_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kontak telah disapa"
                        android:textColor="@color/nx_text_3"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat ›"
                    android:textColor="@color/nx_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============ CREDIT ============ -->
            <LinearLayout
                android:id="@+id/layout_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Made by Nixxy"
                    android:textColor="@color/nx_text_2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="v1.0"
                    android:textColor="@color/nx_text_3"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============ TOMBOL MULAI (menempel di bawah) ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_fade"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_launch_overlay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="🚀  Mulai &amp; Buka MiChat"
            android:textAllCaps="false"
            android:textColor="@color/nx_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/nx_primary"
            app:cornerRadius="18dp"
            app:elevation="8dp" />
    </FrameLayout>
</FrameLayout>
