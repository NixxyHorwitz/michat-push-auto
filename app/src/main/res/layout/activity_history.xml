<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111319"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_history_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_dark"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Pengiriman"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_history_total_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: 0 kontak dikirimi"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Hapus Semua"
            android:textSize="11sp"
            android:textColor="#FF5252"
            android:background="@drawable/btn_secondary_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/et_search_history"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_history_card"
        android:hint="🔍 Cari nama kontak..."
        android:textColorHint="#606C82"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Filter Tab/Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="Semua"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_dark"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_filter_female"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="♀ Perempuan"
            android:textSize="11sp"
            android:textColor="#FF4081"
            android:background="@drawable/btn_secondary_dark"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_filter_male"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="♂ Laki-laki"
            android:textSize="11sp"
            android:textColor="#448AFF"
            android:background="@drawable/btn_secondary_dark" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada kontak yang disapa.\nJalankan bot pada menu Pengguna di Sekitar untuk mulai merekam riwayat."
        android:textColor="#7A869A"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- List of Sent Users -->
    <ListView
        android:id="@+id/lv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

</LinearLayout>
